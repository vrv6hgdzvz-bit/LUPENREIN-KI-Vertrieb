# LUPENREIN KI Vertrieb · Produktionsvariablen
# Niemals echte Secrets committen. In Vercel/Supabase als Environment Variables hinterlegen.

# Lokaler Fallback-Login (nur Entwicklung, wenn Supabase NICHT konfiguriert ist)
APP_LOGIN_EMAIL=admin@lupenrein.local
APP_LOGIN_PASSWORD=change-me

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Bevorzugt 2026: neuer Publishable Key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy-Fallback: anon key; nur nutzen, falls das Projekt noch keine neuen Keys verwendet
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bevorzugt 2026: serverseitiger Secret Key (sb_secret_...). NIEMALS NEXT_PUBLIC_ verwenden.
SUPABASE_SECRET_KEY=
# Legacy-Fallback: service_role. NIEMALS im Browser verwenden.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# KI / Lead-Finder
OPENAI_API_KEY=
AI_MODEL=gpt-5-mini
GOOGLE_PLACES_API_KEY=

# Optionaler generischer E-Mail-Connector
EMAIL_SEND_WEBHOOK_URL=
EMAIL_SEND_WEBHOOK_TOKEN=

# Gmail OAuth der externen Web-App
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Produktionsbetrieb
CRON_SECRET=
APP_ENV=development
APP_BASE_URL=http://localhost:3000
